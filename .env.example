# Copy to .env and adjust. Every value has a sane local default in app/config.py.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=quality_insights
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MIN=1440
# JSON array of allowed frontend origins (Vite falls back past 5173)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:5199"]

# Initial passwords for the accounts `python -m app.seed` creates (admin, qa,
# manager). Leave blank and the seed generates a random one per account and
# prints it once. Never commit real values.
SEED_ADMIN_PASSWORD=
SEED_QA_PASSWORD=
SEED_MANAGER_PASSWORD=

# Release QA report (optional). Without a key the report page explains that it
# is not set up. The key stays on the server and never reaches the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
