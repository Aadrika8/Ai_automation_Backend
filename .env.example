# Copy to .env and adjust. Every value has a sane local default in app/config.py.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=quality_insights
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MIN=1440
# OpenAI key for AI report generation (endpoint returns 503 while empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:5199"]
